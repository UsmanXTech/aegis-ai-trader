{
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server", "serve"],
      "env": {
        "ALPACA_API_KEY": "YOUR_PAPER_API_KEY",
        "ALPACA_SECRET_KEY": "YOUR_PAPER_SECRET_KEY",
        "ALPACA_TOOLSETS": "account,trading,options,stock-data"
      }
    }
  }
}
